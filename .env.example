# Copy to backend/.env - everything here has a working local default.

DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=*

# Leave DATABASE_URL empty to use sqlite locally.
# DATABASE_URL=postgres://saas:saas@127.0.0.1:5432/saas
# POSTGRES_DB=saas
# POSTGRES_USER=saas
# POSTGRES_PASSWORD=saas
# POSTGRES_HOST=127.0.0.1
# POSTGRES_PORT=5432

# Without a Stripe key the billing flow uses a local fake provider that really
# activates subscriptions, so the UI is clickable end to end.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

FRONTEND_URL=http://localhost:3002
CORS_ALLOWED_ORIGINS=http://localhost:3002,http://127.0.0.1:3002
